# =============================================================================
# Dashboard E2E (Playwright) Test Pipeline — Variable Configuration
# =============================================================================
# Copy to vars.yaml and adjust values for your environment.
# Jenkins sets most of these via environment variables; the playbook falls back
# to these defaults when running manually.
# =============================================================================

# --- AWS infrastructure ---
aws_region: "us-west-1"
aws_ssh_user: "ubuntu"
aws_instance_type: "t3a.xlarge"
aws_volume_size: 60
aws_volume_type: "gp3"
aws_ami: "ami-xxxxxxxxxxxxxxxxx"
aws_security_group: "sg-xxxxxxxxxxxxxxxxx"
aws_subnet: "subnet-xxxxxxxxxxxxxxxxx"
aws_vpc: "vpc-xxxxxxxxxxxxxxxxx"
aws_route53_zone: "example.your-domain.com"

# --- K3s ---
k3s_kubernetes_version: "v1.30.0+k3s1"
server_count: 3

# --- Rancher ---
rancher_helm_repo: "rancher-com-rc"
rancher_image_tag: "v2.14-head"
cert_manager_version: "1.11.0"
bootstrap_password: "password"
rancher_password: "password1234"
rancher_username: "admin"

# --- Test-runner pinned versions ---
# Playwright's official Docker image bundles browsers + Node. Pin the tag to a
# specific release for reproducibility. See https://playwright.dev/docs/docker
playwright_image: "mcr.microsoft.com/playwright:v1.52.0-noble"

# --- Dashboard-e2e-pw repo ---
# Forks for ad-hoc testing: set dashboard_pw_repo to your fork (e.g. "izaac/dashboard-e2e-pw")
dashboard_pw_repo: "rancher/dashboard-e2e-pw"
dashboard_pw_branch: "main"

# --- Playwright ---
# Grep expression passed to `playwright test --grep`. Mirrors Cypress @tags
# semantics but uses Playwright's tag syntax — see
# https://playwright.dev/docs/test-annotations#tag-tests
pw_grep_tags: "@adminUser"
job_type: "recurring"              # recurring | existing
create_initial_clusters: true
# rancher_host: ""                 # Required for job_type=existing

# --- Reporting ---
qase_enabled: false
qase_project: "RM"
# qase_debug: false
