# WARNING: Auto-generated by Ansible — contains secrets. Do NOT commit.
TEST_BASE_URL=https://{{ rancher_host }}/dashboard
TEST_USERNAME={{ 'standard_user' if '@standardUser' in pw_grep_tags else rancher_username | default('admin') }}
TEST_PASSWORD={{ rancher_password }}
# Skip first-time Rancher bootstrap tests — Ansible already bootstrapped via rancher-playbook.yml.
# `TEST_SKIP=setup` is read by playwright.config.ts (substring match on 'setup').
TEST_SKIP=setup
AWS_ACCESS_KEY_ID={{ aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ aws_secret_access_key }}
{% if azure_client_id | default('') | length > 0 %}
AZURE_CLIENT_ID={{ azure_client_id }}
AZURE_CLIENT_SECRET={{ azure_client_secret }}
AZURE_AKS_SUBSCRIPTION_ID={{ azure_subscription_id }}
{% endif %}
{% if gke_service_account | default('') | length > 0 %}
GKE_SERVICE_ACCOUNT={{ gke_service_account }}
{% endif %}
CUSTOM_NODE_IP={{ custom_node_ip | default('') }}
CUSTOM_NODE_KEY={{ custom_node_key | default('') }}
CUSTOM_NODE_USER={{ aws_ssh_user | default('ec2-user') }}
QASE_REPORT={{ 'true' if qase_enabled | default(false) else 'false' }}
QASE_PROJECT={{ qase_project | default('SANDBOX') }}
{% if qase_debug | default(false) %}
QASE_DEBUG=true
{% endif %}
{% if qase_token | default('') | length > 0 %}
QASE_AUTOMATION_TOKEN={{ qase_token }}
{% endif %}
GREP_TAGS={{ pw_grep_tags }}
RANCHER_IMAGE_TAG={{ rancher_image_tag_resolved | default(rancher_image_tag) }}
RANCHER_VERSION={{ rancher_version | default('') }}
# CATTLE_BOOTSTRAP_PASSWORD is intentionally NOT set — Ansible already bootstrapped
# Rancher via rancher-playbook.yml, so the PW setup project should not load.
# Auth uses TEST_PASSWORD via the rancher-auth fixture's fallback.

